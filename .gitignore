# Third-party data and source archives stay local. Nothing under these
# directories is tracked; each dataset's public origin is recorded in
# FEASIBILITY.md, so everything is re-fetchable from the primary source.
data/
sources/

# Internal planning documents
Exposure_Skew_Foundation_Sheet.md
Exposure Skew Foundation Sheet.md
_private/

# Derived tables carrying third-party (AIOE / OEWS / Webb) per-occupation values
# stay local; only aggregate results, our own mapping, code and figures are tracked.
outputs/local/

# Hand-off bundles for external recompute carry third-party per-occupation values.
handoff/

# Scratch, environments, OS noise
scratchpad/
__pycache__/
.venv/
*.pyc
.DS_Store
Thumbs.db
